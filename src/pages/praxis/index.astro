---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import CallBand from '../../components/CallBand.astro';
import { PRACTICE } from '../../data/practice';
import { TREATMENTS } from '../../data/treatments';
---
<Base
  title="Die Praxis – Dr. Hrvoje Marijan, Zahnarzt in München"
  description="Die Zahnarztpraxis Dr. Hrvoje Marijan in der Kapuzinerstraße 11, München-Isarvorstadt: was öffentlich belegt ist, welche Bereiche sie abdeckt und wie Sie Kontakt aufnehmen."
>
  <PageHero
    eyebrow="Praxis"
    title="Eine Praxis in der Kapuzinerstraße"
    lede="Wer hier behandelt, wo die Praxis liegt und wie Sie einen Termin bekommen."
    parent={{ href: '/', label: 'Startseite' }}
  />

  <section class="section" aria-labelledby="ueber-title">
    <div class="shell praxis__grid">
      <div class="praxis__main">
        <h2 id="ueber-title" class="praxis__h2">Die Praxis</h2>
        <p class="praxis__lede">
          Dr. Hrvoje Marijan führt eine zahnärztliche Praxis in der Kapuzinerstraße 11 in München.
          Der Standort liegt in der Ludwigsvorstadt-Isarvorstadt, südlich der Innenstadt.
        </p>
        <p>
          Die Praxis führt die Bezeichnung „{PRACTICE.practiceName}". Behandelt werden
          gesetzlich und privat Versicherte. Termine werden telefonisch vereinbart.
        </p>
        <p>
          Der Auftritt der Praxis wendet sich auf Deutsch und auf Bosnisch, Kroatisch und
          Serbisch an Patientinnen und Patienten. Ob auch das Gespräch in der Praxis auf BKS
          möglich ist, fragen Sie am besten kurz am Telefon.
        </p>

        <h2 class="praxis__h2">Womit sich die Praxis befasst</h2>
        <p>
          Vier Bereiche bilden den Kern der Arbeit. Zu jedem gibt es eine eigene Seite:
        </p>
        <ul class="praxis__list">
          {TREATMENTS.map((t) => (
            <li>
              <a class="link" href={t.slug === 'behandlungen' ? '/behandlungen/' : `/${t.slug}/`}>
                {t.nav}
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true"><path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/></svg>
              </a>
              <span class="praxis__list-note">{t.teaser}</span>
            </li>
          ))}
        </ul>
        <p class="praxis__caveat fine">
          Was darüber hinaus möglich ist, fragen Sie am besten direkt in der Praxis nach.
        </p>

      </div>

      <aside class="praxis__side" aria-label="Praxisangaben">
        <div class="panel">
          <h2 class="panel__h">Auf einen Blick</h2>
          <dl class="panel__dl">
            <div><dt>Praxis</dt><dd>{PRACTICE.practiceName}</dd></div>
            <div><dt>Zahnarzt</dt><dd>{PRACTICE.doctor}</dd></div>
            <div><dt>Adresse</dt><dd>{PRACTICE.street}<br />{PRACTICE.postalCode} {PRACTICE.city}</dd></div>
            <div><dt>Stadtbezirk</dt><dd>{PRACTICE.district}</dd></div>
            <div><dt>Telefon</dt><dd><a href={PRACTICE.phoneHref}>{PRACTICE.phoneDisplay}</a></dd></div>
            <div><dt>Sprechzeiten</dt><dd class="panel__missing">Bitte telefonisch erfragen</dd></div>
            <div><dt>Termine</dt><dd>Telefonisch</dd></div>
            <div><dt>Instagram</dt><dd><a href={PRACTICE.instagram} rel="noopener noreferrer" target="_blank">{PRACTICE.instagramHandle}</a></dd></div>
          </dl>
          <a class="btn panel__cta" href={PRACTICE.phoneHref}>Termin telefonisch vereinbaren</a>
        </div>
      </aside>
    </div>
  </section>

  <CallBand
    title="Fragen zur Praxis?"
    note="Am Telefon lässt sich am schnellsten klären, was für Sie infrage kommt."
  />
</Base>

<style>
  .praxis__grid { display: grid; gap: var(--sp-6); }
  .praxis__main { max-width: 42rem; }
  .praxis__h2 {
    font-size: var(--fs-h3);
    margin: var(--sp-6) 0 var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule);
    max-width: 24ch;
  }
  .praxis__h2:first-child { margin-top: 0; padding-top: 0; border-top: 0; }
  .praxis__lede { font-size: var(--fs-lede); line-height: 1.55; color: var(--muted); }
  .praxis__main p + p { margin-top: 0.9rem; }

  .praxis__list { list-style: none; display: grid; gap: var(--sp-3); margin-top: var(--sp-3); }
  .praxis__list li { display: grid; gap: 0.3rem; }
  .praxis__list-note { color: var(--muted); font-size: var(--fs-sm); max-width: 44ch; }
  .praxis__caveat { margin-top: var(--sp-4); font-size: var(--fs-sm); color: var(--muted); }

  .gaps {
    list-style: none;
    display: grid;
    gap: 0.55rem;
    margin-top: var(--sp-3);
    max-width: 34rem;
  }
  .gaps li {
    position: relative;
    padding-left: 1.5rem;
    font-size: var(--fs-sm);
    color: var(--muted);
  }
  .gaps li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.68em;
    width: 0.7rem; height: 1px;
    background: var(--muted);
  }

  .panel { padding: clamp(1.35rem, 1rem + 1.6vw, 2rem); background: var(--paper); border: 1px solid var(--rule); }
  .panel__h { font-size: var(--fs-lede); margin-bottom: var(--sp-3); }
  .panel__dl { display: grid; margin: 0; border-top: 1px solid var(--rule); }
  .panel__dl > div {
    display: grid;
    grid-template-columns: minmax(6rem, 7.5rem) minmax(0, 1fr);
    gap: var(--sp-2);
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .panel__dl dt {
    font-size: 0.6875rem;
    letter-spacing: 0.13em;
    text-transform: uppercase;
    color: var(--muted);
    padding-top: 0.3em;
  }
  .panel__dl dd { margin: 0; font-size: var(--fs-sm); line-height: 1.5; }
  .panel__dl a { text-underline-offset: 3px; }
  .panel__missing { color: var(--muted); }
  .panel__cta { margin-top: var(--sp-4); width: 100%; justify-content: center; }

  @media (min-width: 62rem) {
    .praxis__grid { grid-template-columns: minmax(0, 1fr) minmax(0, 21rem); column-gap: clamp(2.5rem, 1rem + 5vw, 5rem); align-items: start; }
    .praxis__side { position: sticky; top: 6.5rem; }
  }
</style>
