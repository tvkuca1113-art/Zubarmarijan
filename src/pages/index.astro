---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import ToothScene from '../components/ToothScene.astro';
import Figure from '../components/Figure.astro';
import Accordion from '../components/Accordion.astro';
import CopyAddress from '../components/CopyAddress.astro';
import { PRACTICE } from '../data/practice';
import { HOME_FAQ } from '../data/faq';
import { BODY_STREET_LANDMARK_CONFIRMED, BODY_STREET_CAPTION } from '../data/assets';

const treatments = [
  { n: '01', title: 'Untersuchung & Beratung', line: 'Befund erheben, Fragen klären, die nächsten Schritte besprechen.', href: '/behandlungen/', cta: 'Zur Untersuchung' },
  { n: '02', title: 'Professionelle Zahnreinigung', line: 'Beläge dort entfernen, wo Bürste und Zahnseide nicht hinkommen.', href: '/professionelle-zahnreinigung-muenchen/', cta: 'Zur Zahnreinigung' },
  { n: '03', title: 'Kronen & Brücken', line: 'Fester Zahnersatz, wenn ein Zahn stark zerstört ist oder fehlt.', href: '/kronen-bruecken-muenchen/', cta: 'Zu Kronen & Brücken' },
  { n: '04', title: 'Zahnentfernung', line: 'Erst dann, wenn ein Zahn nicht mehr zu erhalten ist.', href: '/zahnentfernung-muenchen/', cta: 'Zur Zahnentfernung' },
];

const steps = [
  { n: '01', h: 'Anrufen', p: 'Unter 089 537901. Meldet sich niemand, wird gerade behandelt – versuchen Sie es kurz später noch einmal.' },
  { n: '02', h: 'Anliegen nennen', p: 'Ein, zwei Sätze genügen. Danach richtet sich, wie viel Zeit für Sie eingeplant wird.' },
  { n: '03', h: 'Fragen notieren', p: 'Schreiben Sie vorher auf, was Sie ansprechen möchten. Im Behandlungsstuhl gerät das schnell in den Hintergrund.' },
];
---
<Base
  headerTheme="ink"
  title="Dr. Hrvoje Marijan – Zahnarzt in München, Kapuzinerstraße 11"
  description="Zahnarztpraxis Dr. Hrvoje Marijan in München-Isarvorstadt. Untersuchung, professionelle Zahnreinigung, Kronen und Brücken, Zahnentfernung. Termine telefonisch unter 089 537901."
>
  <Hero />

  <ToothScene />

  <!-- Behandlungen ------------------------------------------------------- -->
  <section class="section band-paper" aria-labelledby="beh-title">
    <div class="shell treat">
      <div class="treat__intro">
        <span class="tick" aria-hidden="true"></span>
        <h2 id="beh-title">Womit sich die Praxis befasst</h2>
        <p class="treat__note">
          Untersuchung und Beratung stehen am Anfang. Was danach sinnvoll ist,
          entscheidet sich im Gespräch – nicht vorher.
        </p>
      </div>

      <ul class="treat__list">
        {treatments.map((t) => (
          <li class="treat__item">
            <span class="treat__num">{t.n}</span>
            <h3 class="treat__title">{t.title}</h3>
            <p class="treat__line">{t.line}</p>
            <a class="link treat__cta" href={t.href}>
              {t.cta}
              <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Der Zahnarzt --------------------------------------------------------- -->
  <section class="section band-warm" aria-labelledby="arzt-title">
    <div class="shell doc">
      <div class="doc__main">
        <p class="eyebrow eyebrow--accent">Der Zahnarzt</p>
        <h2 id="arzt-title" class="doc__claim">Eine Praxis.<br />Ein Ansprechpartner.</h2>
        <p class="doc__text">
          Dr. Hrvoje Marijan führt seine zahnärztliche Praxis in der Kapuzinerstraße 11,
          mitten in der Ludwigsvorstadt-Isarvorstadt. Wer hier anruft, bespricht die
          Behandlung mit dem Zahnarzt, der sie auch durchführt.
        </p>
        <p class="doc__text">
          Der Auftritt der Praxis wendet sich auf Deutsch und auf Bosnisch, Kroatisch
          und Serbisch an Patientinnen und Patienten.
        </p>
        <a class="link doc__link" href="/praxis/">
          Mehr über die Praxis
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </a>
      </div>

      <dl class="doc__facts">
        <div><dt>Praxis</dt><dd>{PRACTICE.practiceName}</dd></div>
        <div><dt>Fachgebiet</dt><dd>Zahnarzt</dd></div>
        <div><dt>Stadtbezirk</dt><dd>{PRACTICE.district}</dd></div>
        <div><dt>Versicherung</dt><dd>Gesetzlich und privat Versicherte</dd></div>
        <div><dt>Termine</dt><dd>Telefonisch unter <a href={PRACTICE.phoneHref}>{PRACTICE.phoneDisplay}</a></dd></div>
      </dl>
    </div>
  </section>

  <!-- Ihr erster Termin ---------------------------------------------------- -->
  <section class="section section--tight band-surface" aria-labelledby="ersttermin-title">
    <div class="shell">
      <div class="first__head">
        <span class="tick" aria-hidden="true"></span>
        <h2 id="ersttermin-title">Ihr erster Termin</h2>
      </div>
      <ol class="first__steps">
        {steps.map((s) => (
          <li class="first__step">
            <span class="first__num">{s.n}</span>
            <h3 class="first__h">{s.h}</h3>
            <p class="first__p">{s.p}</p>
          </li>
        ))}
      </ol>
      <a class="btn first__cta" href={PRACTICE.phoneHref}>
        <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round"/>
        </svg>
        <span>Termin telefonisch vereinbaren</span>
      </a>
    </div>
  </section>

  <!-- BHS ------------------------------------------------------------------ -->
  <section class="section section--tight band-paper" aria-labelledby="bhs-title">
    <div class="shell bhs">
      <div>
        <p class="eyebrow eyebrow--accent">Hrvatski · Bosanski · Srpski</p>
        <h2 id="bhs-title" class="bhs__title" lang="hr">Informacije na hrvatskom</h2>
      </div>
      <div class="bhs__body">
        <p lang="hr" class="bhs__hr">
          Adresa, telefon, područja rada i kako dogovoriti termin – sažeto na
          bosanskom, hrvatskom i srpskom.
        </p>
        <p class="bhs__de">
          Die wichtigsten Angaben zur Praxis, zusammengefasst auf Bosnisch, Kroatisch
          und Serbisch.
        </p>
        <a class="btn btn--outline bhs__cta" href="/hr/" lang="hr">Otvorite stranicu</a>
      </div>
    </div>
  </section>

  <!-- Fragen ---------------------------------------------------------------- -->
  <section class="section band-paper" aria-labelledby="faq-title">
    <div class="shell faq">
      <div class="faq__aside">
        <span class="tick" aria-hidden="true"></span>
        <h2 id="faq-title">Häufige Fragen</h2>
        <p class="faq__note">Kurz beantwortet, bevor Sie zum Hörer greifen.</p>
      </div>
      <div class="faq__list">
        <Accordion items={HOME_FAQ} idPrefix="home-faq" />
      </div>
    </div>
  </section>

  <!-- Kontakt & Anfahrt ------------------------------------------------------ -->
  <section class="section band-warm" id="kontakt" aria-labelledby="kontakt-title">
    <div class="shell">
      <div class="con__head">
        <span class="tick" aria-hidden="true"></span>
        <h2 id="kontakt-title">Kontakt &amp; Anfahrt</h2>
      </div>

      <div class="con">
        <div class="con__media">
          <Figure slot="entrance" sizes="(max-width: 60rem) 92vw, 22rem" />
          <p class="con__caption">
            {BODY_STREET_LANDMARK_CONFIRMED
              ? BODY_STREET_CAPTION
              : 'Der Eingang zum Haus Kapuzinerstraße 11, mit dem blauen Hausnummernschild rechts über der Tür.'}
          </p>
        </div>

        <div class="con__info">
          <a class="con__phone" href={PRACTICE.phoneHref}>{PRACTICE.phoneDisplay}</a>
          <address class="con__addr">
            {PRACTICE.practiceName}<br />
            {PRACTICE.street}<br />
            {PRACTICE.postalCode} {PRACTICE.city}
          </address>
          <div class="btn-row con__actions">
            <a class="btn" href={PRACTICE.phoneHref}>Termin vereinbaren</a>
            <a class="btn btn--outline" href={PRACTICE.mapsUrl} rel="noopener noreferrer" target="_blank">
              Route in Google Maps
              <span class="visually-hidden">(öffnet in einem neuen Tab)</span>
            </a>
          </div>
          <div class="con__copy"><CopyAddress /></div>
          <p class="con__more">
            <a class="link link--inline" href="/kontakt/">Alle Kontaktangaben</a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Abschluss --------------------------------------------------------------- -->
  <section class="closing band-ink" aria-labelledby="closing-title">
    <div class="shell closing__inner">
      <h2 id="closing-title" class="closing__title">Rufen Sie an.</h2>
      <a class="closing__phone" href={PRACTICE.phoneHref}>{PRACTICE.phoneDisplay}</a>
      <p class="closing__addr">{PRACTICE.street} · {PRACTICE.postalCode} {PRACTICE.city}</p>
      <p class="closing__fine">
        Außerhalb der Sprechzeiten hilft der
        <a href={PRACTICE.emergencyUrl} rel="noopener noreferrer" target="_blank">zahnärztliche Notdienst der KZVB</a> weiter.
      </p>
    </div>
  </section>
</Base>

<style>
  /* --- Behandlungen ------------------------------------------------------- */
  .treat { display: grid; gap: var(--sp-5); }
  .treat__note { color: var(--muted); margin-top: var(--sp-3); max-width: 26rem; }
  .treat__list { list-style: none; display: grid; gap: 0; border-top: 1px solid var(--line); }
  .treat__item {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    column-gap: var(--sp-3);
    row-gap: 0.4rem;
    padding-block: var(--sp-4);
    border-bottom: 1px solid var(--line);
  }
  .treat__num {
    grid-row: 1 / span 3;
    font-family: var(--font-display);
    font-size: 0.75rem; font-weight: 700; letter-spacing: 0.1em;
    color: var(--accent-ink); padding-top: 0.45em; font-variant-numeric: tabular-nums;
  }
  .treat__title { font-size: var(--fs-h3); }
  .treat__line { color: var(--muted); font-size: var(--fs-sm); max-width: 32rem; margin: 0; }
  .treat__cta { justify-self: start; font-size: var(--fs-sm); }
  @media (min-width: 60rem) {
    .treat { grid-template-columns: minmax(0, 0.72fr) minmax(0, 1fr); column-gap: clamp(2.5rem, 1rem + 5vw, 6rem); align-items: start; }
    .treat__item { grid-template-columns: 2.75rem minmax(0, 16rem) minmax(0, 1fr) auto; align-items: baseline; column-gap: var(--sp-4); }
    .treat__title { grid-column: 2; }
    .treat__line { grid-column: 3; }
    .treat__cta { grid-column: 4; grid-row: 1; }
  }

  /* --- Der Zahnarzt -------------------------------------------------------- */
  .doc { display: grid; gap: var(--sp-5); }
  .doc__claim { margin: var(--sp-3) 0 var(--sp-4); }
  .doc__text { color: var(--muted); }
  .doc__text + .doc__text { margin-top: 0.9rem; }
  .doc__link { margin-top: var(--sp-4); }
  .doc__facts { display: grid; margin: 0; border-top: 2px solid var(--text); }
  .doc__facts > div {
    display: grid; grid-template-columns: minmax(6.5rem, 8.5rem) minmax(0, 1fr);
    gap: var(--sp-3); padding-block: 0.9rem; border-bottom: 1px solid var(--line);
  }
  .doc__facts dt {
    font-family: var(--font-display); font-size: 0.6875rem; font-weight: 700;
    letter-spacing: 0.13em; text-transform: uppercase; color: var(--muted); padding-top: 0.35em;
  }
  .doc__facts dd { margin: 0; font-size: var(--fs-sm); }
  .doc__facts a { text-underline-offset: 3px; }
  @media (min-width: 60rem) {
    .doc { grid-template-columns: minmax(0, 1fr) minmax(0, 0.8fr); column-gap: clamp(2.5rem, 1rem + 5vw, 6rem); align-items: start; }
  }

  /* --- Ihr erster Termin --------------------------------------------------- */
  .first__head { margin-bottom: var(--sp-5); }
  .first__steps { list-style: none; display: grid; gap: var(--sp-4); }
  .first__step { padding-top: var(--sp-3); border-top: 2px solid var(--text); }
  .first__num {
    display: block; font-family: var(--font-display); font-size: 0.75rem; font-weight: 700;
    letter-spacing: 0.12em; color: var(--accent-ink); margin-bottom: 0.7rem; font-variant-numeric: tabular-nums;
  }
  .first__h { font-size: var(--fs-h3); margin-bottom: 0.5rem; }
  .first__p { color: var(--muted); font-size: var(--fs-sm); }
  .first__cta { margin-top: var(--sp-5); }
  @media (min-width: 48rem) { .first__steps { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--sp-4); } }

  /* --- BHS ----------------------------------------------------------------- */
  .bhs { display: grid; gap: var(--sp-4); }
  .bhs__title { font-size: var(--fs-h2); margin-top: var(--sp-2); }
  .bhs__hr { font-size: var(--fs-lede); color: var(--text); }
  .bhs__de { color: var(--muted); font-size: var(--fs-sm); margin-top: 0.7rem; }
  .bhs__cta { margin-top: var(--sp-4); }
  @media (min-width: 56rem) {
    .bhs { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); column-gap: var(--sp-6); align-items: center; }
  }

  /* --- FAQ ----------------------------------------------------------------- */
  .faq { display: grid; gap: var(--sp-5); }
  .faq__note { color: var(--muted); margin-top: var(--sp-3); max-width: 22rem; }
  @media (min-width: 60rem) {
    .faq { grid-template-columns: minmax(0, 0.68fr) minmax(0, 1fr); column-gap: clamp(2.5rem, 1rem + 5vw, 6rem); align-items: start; }
    .faq__aside { position: sticky; top: 6.5rem; }
  }

  /* --- Kontakt ------------------------------------------------------------- */
  .con__head { margin-bottom: var(--sp-5); }
  .con { display: grid; gap: var(--sp-5); }
  .con__media { max-width: 22rem; }
  .con__caption { margin-top: 0.85rem; font-size: var(--fs-fine); color: var(--muted); line-height: 1.55; }
  .con__phone {
    display: inline-block;
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.25rem, 1.4rem + 3.4vw, 3.75rem);
    letter-spacing: -0.035em; line-height: 1;
    text-decoration: none; margin-bottom: var(--sp-3);
  }
  .con__phone:hover { color: var(--accent-ink); }
  .con__addr { font-style: normal; font-size: var(--fs-lede); line-height: 1.6; color: var(--muted); }
  .con__actions { margin-top: var(--sp-4); }
  .con__copy { margin-top: var(--sp-4); }
  .con__more { margin-top: var(--sp-4); }
  @media (min-width: 60rem) {
    .con { grid-template-columns: minmax(0, 22rem) minmax(0, 1fr); column-gap: clamp(2.5rem, 1rem + 5vw, 5rem); align-items: start; }
  }

  /* --- Abschluss ------------------------------------------------------------ */
  .closing { padding-block: clamp(3.5rem, 2.4rem + 5vw, 7rem); }
  .closing__inner { display: grid; justify-items: center; text-align: center; gap: var(--sp-2); }
  .closing__title { font-size: var(--fs-h2); margin: 0; }
  .closing__phone {
    font-family: var(--font-display); font-weight: 700;
    font-size: clamp(2.5rem, 1.5rem + 4.2vw, 4.5rem);
    letter-spacing: -0.04em; color: var(--paper); text-decoration: none; margin-top: var(--sp-2);
  }
  .closing__phone:hover { color: var(--accent-lift); }
  .closing__addr { color: var(--muted-ink); font-size: var(--fs-sm); margin: 0; }
  .closing__fine { margin-top: var(--sp-4); font-size: var(--fs-fine); color: #8ea4b4; max-width: 34rem; }
  .closing__fine a { color: #cfdae2; text-underline-offset: 3px; }
</style>
