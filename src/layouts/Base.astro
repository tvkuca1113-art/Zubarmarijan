---
import BaseHead from '../components/BaseHead.astro';
import DemoNotice from '../components/DemoNotice.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
  /** 'ink' when the page opens on the dark stage. */
  headerTheme?: 'ink' | 'paper';
}
const { title, description, lang = 'de', headerTheme = 'paper' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <DemoNotice />
    <SiteHeader theme={headerTheme} />
    <main id="inhalt">
      <slot />
    </main>
    <SiteFooter />
    <MobileActionBar />
  </body>
</html>
