---
import BaseHead from '../components/BaseHead.astro';
import DemoNotice from '../components/DemoNotice.astro';
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import MobileCallBar from '../components/MobileCallBar.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  lang?: string;
}
const { title, description, lang = 'de' } = Astro.props;
---
<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#inhalt">Zum Inhalt springen</a>
    <DemoNotice />
    <SiteHeader />
    <main id="inhalt">
      <slot />
    </main>
    <SiteFooter />
    <MobileCallBar />

    <script>
      // Hairline under the header, only once the page has actually scrolled.
      const hdr = document.querySelector('.hdr');
      if (hdr) {
        const sync = () => hdr.setAttribute('data-stuck', String(window.scrollY > 8));
        sync();
        window.addEventListener('scroll', sync, { passive: true });
      }
    </script>
  </body>
</html>
