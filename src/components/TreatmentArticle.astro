---
import Figure from './Figure.astro';
import CallBand from './CallBand.astro';
import { TREATMENTS, type Treatment } from '../data/treatments';
import { IMAGE_SLOTS } from '../data/assets';
import { PRACTICE } from '../data/practice';

interface Props { treatment: Treatment; }
const { treatment: t } = Astro.props;

const others = TREATMENTS.filter((o) => o.slug !== t.slug);

/* A square plate at full column width dominates the article; a landscape one can
   afford more room. Cap each by its own proportions. */
const slotCfg = t.imageSlot ? IMAGE_SLOTS[t.imageSlot] : null;
const isSquare = slotCfg ? slotCfg.ratio[0] / slotCfg.ratio[1] <= 1.05 : false;
const mediaMax = isSquare ? '24rem' : '33rem';
const hrefFor = (slug: string) => (slug === 'behandlungen' ? '/behandlungen/' : `/${slug}/`);
---
<article class="art">
  <div class="section">
    <div class="shell art__grid">
      <div class="art__body">
        {t.intro.map((p) => <p class="art__lede">{p}</p>)}

        {t.imageSlot && (
          <div class="art__media" style={`max-width:${mediaMax}`}>
            <Figure slot={t.imageSlot as any} sizes={`(max-width: 56rem) 88vw, ${mediaMax}`} />
          </div>
        )}

        {t.sections.map((s) => (
          <section class="art__section">
            <h2 class="art__h2">{s.heading}</h2>
            {s.paragraphs.map((p) => <p>{p}</p>)}
          </section>
        ))}
      </div>

      <aside class="art__aside" aria-label="Für das Gespräch">
        <div class="card">
          <h2 class="card__h">Fragen für das Gespräch</h2>
          <ul class="card__list">
            {t.discuss.map((d) => <li>{d}</li>)}
          </ul>
        </div>

        <div class="card card--muted">
          <h2 class="card__h">Nur die Praxis kann das beantworten</h2>
          <ul class="card__list">
            {t.clarify.map((c) => <li>{c}</li>)}
          </ul>
          <a class="btn btn--accent card__cta" href={PRACTICE.phoneHref}>
            <svg class="btn__icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
              <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round"/>
            </svg>
            <span>{PRACTICE.phoneDisplay}</span>
          </a>
        </div>

        <p class="art__sources">
          Allgemeine medizinische Hintergründe in eigenen Worten zusammengefasst nach:
          {t.sources.map((s, i) => (
            <>
              {i > 0 && ', '}
              <a href={s.url} rel="noopener noreferrer nofollow" target="_blank">{s.label}</a>
            </>
          ))}. Diese Seite ersetzt keine Untersuchung und trifft keine Aussage über Ihren Fall.
        </p>
      </aside>
    </div>
  </div>

  <CallBand />

  <section class="section section--tight band-paper" aria-labelledby="weiter-title">
    <div class="shell">
      <p class="eyebrow eyebrow--accent">Weiterlesen</p>
      <h2 id="weiter-title" class="weiter__title">Andere Bereiche</h2>
      <ul class="weiter">
        {others.map((o) => (
          <li>
            <a class="weiter__link" href={hrefFor(o.slug)}>
              <span class="weiter__name">{o.nav}</span>
              <span class="weiter__teaser">{o.teaser}</span>
              <span class="weiter__arrow" aria-hidden="true">→</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</article>

<style>
  .art__grid { display: grid; gap: var(--sp-6); }
  .art__body { max-width: 42rem; }
  .art__lede {
    font-size: var(--step-1);
    line-height: 1.55;
    color: var(--ink-70);
    max-width: 36rem;
  }
  .art__lede + .art__lede { margin-top: var(--sp-3); }
  .art__media { margin-block: var(--sp-5); }

  .art__section { margin-top: var(--sp-6); }
  .art__h2 {
    font-size: var(--step-2);
    margin-bottom: var(--sp-3);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--rule);
    max-width: 24ch;
  }
  .art__section p + p { margin-top: 0.9rem; }

  .art__aside { display: grid; gap: var(--sp-4); align-content: start; }
  .card {
    padding: clamp(1.25rem, 1rem + 1.4vw, 1.85rem);
    background: var(--paper);
    border: 1px solid var(--rule);
  }
  .card--muted { background: var(--sand); border-color: #d9d2c5; }
  .card__h {
    font-size: var(--step-1);
    margin-bottom: var(--sp-3);
    letter-spacing: -0.008em;
  }
  .card__list { list-style: none; display: grid; gap: 0.7rem; }
  .card__list li {
    position: relative;
    padding-left: 1.4rem;
    font-size: 0.9375rem;
    line-height: 1.55;
    color: var(--ink-70);
  }
  .card__list li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.68em;
    width: 0.6rem; height: 1px;
    background: var(--accent);
  }
  .card__cta { margin-top: var(--sp-4); width: 100%; justify-content: center; }
  .art__sources { font-size: 0.8125rem; color: var(--ink-55); line-height: 1.6; max-width: 30rem; }
  .art__sources a { color: inherit; text-underline-offset: 3px; }

  @media (min-width: 62rem) {
    .art__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 21rem);
      column-gap: clamp(2.5rem, 1rem + 5vw, 5rem);
      align-items: start;
    }
    .art__aside { position: sticky; top: 6.5rem; }
  }

  .weiter { list-style: none; margin-top: var(--sp-4); border-top: 1px solid var(--rule); }
  .weiter__title { font-size: var(--step-2); margin-top: var(--sp-2); }
  .weiter__link {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 1.5rem;
    gap: 0.35rem var(--sp-3);
    padding: var(--sp-3) 0;
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    transition: padding-inline 300ms var(--ease), background 300ms var(--ease);
  }
  .weiter__link:hover { background: var(--warm-white); padding-inline: 0.85rem; }
  .weiter__name { font-family: var(--font-display); font-size: var(--step-1); }
  .weiter__teaser { grid-column: 1; color: var(--muted); font-size: var(--step--1); max-width: 48ch; }
  .weiter__arrow { grid-row: 1; grid-column: 2; color: var(--accent); justify-self: end; }
  @media (min-width: 56rem) {
    .weiter__link { grid-template-columns: minmax(0, 16rem) minmax(0, 1fr) 1.5rem; align-items: baseline; }
    .weiter__teaser { grid-column: 2; grid-row: 1; }
    .weiter__arrow { grid-column: 3; }
  }
</style>
