---
/** Discreet, permanent notice that this is an unapproved private concept. */
---
<div class="demo">
  <div class="shell demo__inner">
    <span class="demo__dot" aria-hidden="true"></span>
    <p class="demo__text">
      Privater Entwurf – kein offizieller Auftritt der Praxis.
      <a href="/hinweise/">Was das bedeutet</a>
    </p>
  </div>
</div>

<style>
  .demo {
    background: var(--graphite);
    color: #cfd8da;
    font-size: 0.78125rem;
    line-height: 1.4;
  }
  .demo__inner {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding-block: 0.45rem;
  }
  .demo__dot {
    flex: none;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #8fb3ba;
  }
  .demo__text { margin: 0; max-width: none; }
  .demo__text a {
    color: #fff;
    text-underline-offset: 3px;
    margin-left: 0.35rem;
  }
</style>
