---
/** Discreet, permanent notice that this is an unapproved private concept. */
---
<div class="demo">
  <div class="shell demo__inner">
    <span class="demo__dot" aria-hidden="true"></span>
    <p class="demo__text">Privater Entwurf, kein offizieller Praxisauftritt <a href="/hinweise/">Hinweise</a></p>
  </div>
</div>

<style>
  .demo { background: var(--ink-deep); color: #b9c9d5; font-size: 0.75rem; line-height: 1.4; }
  .demo__inner { display: flex; align-items: center; gap: 0.55rem; padding-block: 0.45rem; }
  .demo__dot { flex: none; width: 5px; height: 5px; border-radius: 50%; background: var(--accent-lift); }
  .demo__text { margin: 0; max-width: none; }
  .demo__text a { color: #fff; text-underline-offset: 3px; margin-left: 0.45rem; }
</style>
