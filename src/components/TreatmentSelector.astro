---
/**
 * "Worüber möchten Sie sprechen?"
 *
 * A plain information selector across the four confirmed categories. It shows
 * background reading and the phone number. It asks nothing, records nothing,
 * assesses no symptoms and makes no urgency judgement.
 */
import { TREATMENTS } from '../data/treatments';
import { PRACTICE } from '../data/practice';

const items = TREATMENTS.map((t) => ({
  id: t.slug,
  nav: t.nav,
  kicker: t.kicker,
  teaser: t.teaser,
  href: t.slug === 'behandlungen' ? '/behandlungen/' : `/${t.slug}/`,
  discuss: t.discuss.slice(0, 3),
}));
---
<div class="sel">
  <div class="sel__tabs" role="tablist" aria-label="Themen für das Gespräch">
    {items.map((item, i) => (
      <button
        class="sel__tab"
        type="button"
        role="tab"
        id={`tab-${item.id}`}
        aria-controls={`panel-${item.id}`}
        aria-selected={i === 0 ? 'true' : 'false'}
        tabindex={i === 0 ? 0 : -1}
      >
        <span class="sel__tab-index">{String(i + 1).padStart(2, '0')}</span>
        <span class="sel__tab-label">{item.nav}</span>
      </button>
    ))}
  </div>

  {items.map((item, i) => (
    <div
      class="sel__panel"
      role="tabpanel"
      id={`panel-${item.id}`}
      aria-labelledby={`tab-${item.id}`}
      tabindex="0"
      hidden={i !== 0}
    >
      <div class="sel__panel-main">
        <p class="eyebrow eyebrow--accent">{item.kicker}</p>
        <p class="serif-note sel__teaser">{item.teaser}</p>
        <p class="sel__intro">Fragen, die sich dazu im Gespräch klären lassen:</p>
        <ul class="sel__points">
          {item.discuss.map((d) => <li>{d}</li>)}
        </ul>
      </div>
      <div class="sel__panel-side">
        <a class="btn btn--accent" href={PRACTICE.phoneHref}>
          <svg class="btn__icon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round"/>
          </svg>
          <span>{PRACTICE.phoneDisplay}</span>
        </a>
        <p class="sel__hint">
          Termine werden telefonisch vereinbart. Nennen Sie beim Anruf kurz Ihr Anliegen –
          so lässt sich die passende Zeit einplanen.
        </p>
        <a class="link" href={item.href}>
          Mehr zu {item.nav}
          <span class="link__arrow" aria-hidden="true">→</span>
        </a>
      </div>
    </div>
  ))}
</div>

<style>
  .sel { display: grid; gap: var(--sp-4); }

  .sel__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  .sel__tab {
    display: inline-flex;
    align-items: baseline;
    gap: 0.55rem;
    min-height: 3rem;
    padding: 0.7rem 1.15rem;
    background: transparent;
    border: 1px solid var(--rule);
    border-radius: 999px;
    cursor: pointer;
    font-size: 0.9375rem;
    text-align: left;
    transition: background 280ms var(--ease), border-color 280ms var(--ease), color 280ms var(--ease);
  }
  .sel__tab:hover { border-color: var(--fg); }
  .sel__tab[aria-selected='true'] {
    background: var(--graphite);
    border-color: var(--graphite);
    color: #fff;
  }
  .sel__tab-index {
    font-size: 0.6875rem;
    letter-spacing: 0.1em;
    color: var(--accent);
    font-variant-numeric: tabular-nums;
  }
  .sel__tab[aria-selected='true'] .sel__tab-index { color: #8fb3ba; }

  .sel__panel {
    display: grid;
    gap: var(--sp-4);
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
  }
  .sel__panel:focus-visible { box-shadow: var(--focus); border-radius: 4px; }
  .sel__teaser { max-width: 30rem; margin: 0.7rem 0 0; }
  .sel__intro { margin: var(--sp-4) 0 0.7rem; color: var(--muted); font-size: var(--step--1); }
  .sel__points { list-style: none; display: grid; gap: 0.5rem; max-width: 34rem; }
  .sel__points li {
    position: relative;
    padding-left: 1.4rem;
    color: var(--muted);
    font-size: var(--step--1);
    line-height: 1.55;
  }
  .sel__points li::before {
    content: '';
    position: absolute;
    left: 0; top: 0.66em;
    width: 0.6rem; height: 1px;
    background: var(--accent);
  }
  .sel__panel-side { display: grid; gap: var(--sp-3); align-content: start; }
  .sel__hint { font-size: var(--step--1); color: var(--muted); margin: 0; max-width: 24rem; }

  @media (min-width: 56rem) {
    .sel__panel { grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr); gap: var(--sp-6); }
    .sel__panel-side { padding-top: 0.35rem; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.sel').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(root.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    if (!tabs.length) return;

    const select = (index: number, focus = true) => {
      tabs.forEach((tab, i) => {
        const on = i === index;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (panels[i]) panels[i].hidden = !on;
      });
      if (focus) tabs[index].focus();
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(i, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next !== null) { e.preventDefault(); select(next); }
      });
    });
  });
</script>
