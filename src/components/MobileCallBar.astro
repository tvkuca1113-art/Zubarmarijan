---
import { PRACTICE } from '../data/practice';
---
<a class="callbar" href={PRACTICE.phoneHref}>
  <span class="callbar__text">
    <span class="callbar__label">Termin vereinbaren</span>
    <span class="callbar__num">{PRACTICE.phoneDisplay}</span>
  </span>
  <span class="callbar__pill">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
      <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round"/>
    </svg>
    Anrufen
  </span>
</a>
