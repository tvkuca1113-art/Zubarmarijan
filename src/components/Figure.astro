---
/**
 * Responsive figure for one of the five image slots.
 *
 * When `npm run assets` has generated derivatives for the slot, this renders a
 * real <picture> with AVIF/WebP/JPEG sources, explicit dimensions and the slot's
 * `sizes`. When the photograph is not present yet, it renders a designed plate at
 * exactly the same aspect ratio - so the composition, spacing and scroll position
 * are identical either way and nothing shifts when the photograph arrives.
 */
import { IMAGE_SLOTS } from '../data/assets';
import manifest from '../data/asset-manifest.json';

interface Props {
  slot: keyof typeof IMAGE_SLOTS;
  class?: string;
  /** Override the slot's default sizes attribute. */
  sizes?: string;
}

const { slot, class: className = '', sizes } = Astro.props;
const cfg = IMAGE_SLOTS[slot];
if (!cfg) throw new Error(`Unknown image slot: ${String(slot)}`);

const entry = (manifest as Record<string, {
  base: string; widths: number[]; intrinsicWidth: number; intrinsicHeight: number; formats: string[];
}>)[cfg.key];

const ratio = `${cfg.ratio[0]} / ${cfg.ratio[1]}`;
/* Plate art is drawn in a box with the slot's own proportions, so `slice` never crops it. */
const vbW = cfg.ratio[0] * 100;
const vbH = cfg.ratio[1] * 100;
const viewBox = `0 0 ${vbW} ${vbH}`;
const sizesAttr = sizes ?? cfg.sizes;

let displayWidth = 0;
let displayHeight = 0;
if (entry) {
  displayWidth = entry.widths[entry.widths.length - 1];
  displayHeight = Math.round((displayWidth / entry.intrinsicWidth) * entry.intrinsicHeight);
}

const srcset = (ext: string) =>
  entry ? entry.widths.map((w) => `/images/derived/${entry.base}-${w}.${ext} ${w}w`).join(', ') : '';
---

{entry ? (
  <picture class={`figure ${className}`} style={`--ratio:${ratio}`}>
    <source type="image/avif" srcset={srcset('avif')} sizes={sizesAttr} />
    <source type="image/webp" srcset={srcset('webp')} sizes={sizesAttr} />
    <img
      src={`/images/derived/${entry.base}-${displayWidth}.jpg`}
      srcset={srcset('jpg')}
      sizes={sizesAttr}
      width={displayWidth}
      height={displayHeight}
      alt={cfg.alt}
      class="figure__img"
      loading={cfg.priority ? 'eager' : 'lazy'}
      fetchpriority={cfg.priority ? 'high' : 'auto'}
      decoding={cfg.priority ? 'sync' : 'async'}
    />
  </picture>
) : (
  <div
    class={`figure plate plate--${cfg.plate} grain ${className}`}
    style={`--ratio:${ratio}`}
    role="img"
    aria-label={`${cfg.plateLabel}: Bildfläche. Das Foto liegt für diesen Entwurf noch nicht vor.`}
  >
    <svg class="plate__art" viewBox={viewBox} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
      {cfg.plate === 'portrait' && (
        <g>
          <path d="M120 500V190a80 80 0 0 1 160 0v310Z" fill="currentColor" opacity="0.16" />
          <path d="M120 500V190a80 80 0 0 1 160 0v310" fill="none" stroke="currentColor" stroke-width="1.4" opacity="0.32" />
          <g opacity="0.16" stroke="currentColor" stroke-width="1.4">
            <line x1="0" y1="352" x2="400" y2="352" />
            <line x1="0" y1="400" x2="400" y2="400" />
            <line x1="0" y1="448" x2="400" y2="448" />
          </g>
        </g>
      )}
      {cfg.plate === 'light' && (
        <g fill="none" stroke="currentColor" opacity="0.26">
          <circle cx="212" cy="95" r="128" stroke-width="1.4" />
          <circle cx="212" cy="95" r="182" stroke-width="1.4" opacity="0.55" />
          <circle cx="212" cy="95" r="74" stroke-width="1.4" opacity="0.8" />
        </g>
      )}
      {cfg.plate === 'instrument' && (
        <g fill="none" stroke="currentColor" opacity="0.3">
          <circle cx="100" cy="112" r="26" stroke-width="1" />
          <circle cx="100" cy="112" r="46" stroke-width="1" opacity="0.7" />
          <circle cx="100" cy="112" r="68" stroke-width="1" opacity="0.45" />
          <line x1="100" y1="22" x2="100" y2="84" stroke-width="1" opacity="0.85" />
        </g>
      )}
      {cfg.plate === 'dark' && (
        <g>
          <ellipse cx="212" cy="152" rx="150" ry="104" fill="currentColor" opacity="0.13" />
          <ellipse cx="212" cy="152" rx="86" ry="60" fill="currentColor" opacity="0.16" />
          <line x1="60" y1="232" x2="340" y2="232" stroke="currentColor" stroke-width="1.4" opacity="0.32" />
        </g>
      )}
      {cfg.plate === 'door' && (
        <g>
          <rect x="72" y="24" width="116" height="176" fill="currentColor" opacity="0.12" />
          <rect x="83" y="35" width="94" height="165" fill="currentColor" opacity="0.2" />
          <rect x="83" y="35" width="94" height="165" fill="none" stroke="currentColor" stroke-width="1.2" opacity="0.4" />
          <line x1="130" y1="35" x2="130" y2="200" stroke="currentColor" stroke-width="1" opacity="0.26" />
          <rect x="216" y="58" width="34" height="44" rx="3" fill="#426a74" opacity="0.5" />
          <rect x="216" y="58" width="34" height="44" rx="3" fill="none" stroke="currentColor" stroke-width="1" opacity="0.32" />
          <line x1="40" y1="186" x2="300" y2="186" stroke="currentColor" stroke-width="1" opacity="0.22" />
        </g>
      )}
    </svg>
    <span class="plate__label">{cfg.plateLabel} · Bild folgt</span>
  </div>
)}

<style>
  .figure {
    display: block;
    position: relative;
    aspect-ratio: var(--ratio);
    width: 100%;
    overflow: hidden;
    background: var(--soft-grey);
  }
  .figure__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .plate {
    color: var(--graphite);
    background: linear-gradient(168deg, #eceae4 0%, #e2e6e4 58%, #dfe4e3 100%);
    display: grid;
    place-items: end start;
  }
  .plate__art {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .plate__label {
    position: relative;
    margin: 1.15rem 1.25rem;
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-70);
    background: rgba(245, 244, 240, 0.82);
    padding: 0.4rem 0.7rem;
    border-radius: 2px;
  }

  .plate--portrait { color: var(--teal); background: linear-gradient(170deg, #eef0ec 0%, #e3ebeb 62%, #dbe5e6 100%); }
  .plate--light { color: var(--teal); background: linear-gradient(120deg, #f2f1ec 0%, #eaebe6 55%, #e6ebea 100%); }
  .plate--instrument { color: #5c7681; background: linear-gradient(150deg, #dfe6e8 0%, #d5dee1 100%); }
  .plate--door { color: #3c4c52; background: linear-gradient(196deg, #e9e7e0 0%, #dde2e1 62%, #d5dcdc 100%); }

  .plate--dark {
    color: #9fc2c8;
    background: radial-gradient(120% 90% at 54% 58%, #22323a 0%, #16232a 46%, #0e171b 100%);
  }
  .plate--dark .plate__label {
    color: #a9b7ba;
    background: rgba(16, 26, 30, 0.72);
  }
</style>
