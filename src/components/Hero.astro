---
import { PRACTICE } from '../data/practice';
import Figure from './Figure.astro';
---
<section class="hero grain" aria-labelledby="hero-title">
  <div class="shell shell--wide hero__inner">
    <div class="hero__text">
      <p class="eyebrow hero__eyebrow">Dr. Hrvoje Marijan · Zahnarzt in München</p>
      <h1 id="hero-title" class="hero__title">
        Gute Zahnmedizin<br />
        beginnt mit <span class="hero__accent">Verstehen</span>.
      </h1>
      <p class="hero__lede">
        Lernen Sie die Praxis in der Kapuzinerstraße kennen – und vereinbaren Sie
        Ihren Termin telefonisch.
      </p>
      <div class="btn-row hero__actions">
        <a class="btn btn--accent" href={PRACTICE.phoneHref}>
          <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
            <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round"/>
          </svg>
          <span>Termin telefonisch vereinbaren</span>
        </a>
        <a class="btn btn--ghost" href="/behandlungen/">Behandlungen entdecken</a>
      </div>
    </div>

    <div class="hero__stage" data-stage>
      <div class="hero__deck">
        <span class="hero__wash" aria-hidden="true"></span>
        <span class="hero__frame" aria-hidden="true"></span>
        <div class="hero__photo">
          <Figure slot="portrait" />
        </div>
        <p class="hero__chip">
          <span class="hero__chip-label">Praxis</span>
          <span class="hero__chip-value">{PRACTICE.district}</span>
        </p>
      </div>
    </div>

    <dl class="hero__facts">
      <div class="hero__fact">
        <dt>Adresse</dt>
        <dd>
          <a class="hero__fact-link" href={PRACTICE.mapsUrl} rel="noopener noreferrer" target="_blank">
            {PRACTICE.street}, {PRACTICE.postalCode} {PRACTICE.city}
          </a>
        </dd>
      </div>
      <div class="hero__fact">
        <dt>Telefon</dt>
        <dd><a class="hero__fact-link hero__fact-link--phone" href={PRACTICE.phoneHref}>{PRACTICE.phoneDisplay}</a></dd>
      </div>
    </dl>
  </div>

  <button class="motion" type="button" data-motion-toggle hidden>
    <span class="motion__dot" aria-hidden="true"></span>
    <span data-motion-label>Bewegung pausieren</span>
  </button>
</section>

<style>
  .hero {
    position: relative;
    overflow: hidden;
    padding-block: clamp(2rem, 1.3rem + 2.6vw, 3.5rem) clamp(3rem, 2rem + 5vw, 6.5rem);
    background:
      radial-gradient(90% 70% at 78% 22%, rgba(66, 106, 116, 0.09) 0%, rgba(66, 106, 116, 0) 62%),
      var(--warm-white);
  }

  .hero__inner { display: grid; gap: clamp(2rem, 1.4rem + 3vw, 3.25rem); }

  .hero__eyebrow { margin-bottom: var(--sp-3); }
  .hero__title {
    font-size: clamp(2.375rem, 1.5rem + 3vw, 4rem);
    margin-bottom: var(--sp-4);
  }
  .hero__accent { color: var(--teal); }
  .hero__lede {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-70);
    max-width: 27rem;
    margin-bottom: var(--sp-4);
  }
  .hero__actions { margin-bottom: 0; }

  /* --- Facts ------------------------------------------------------------- */
  .hero__facts {
    display: grid;
    gap: var(--sp-3);
    margin: 0;
    padding-top: var(--sp-4);
    border-top: 1px solid var(--rule);
  }
  .hero__fact dt {
    font-size: 0.6875rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 0.3rem;
  }
  .hero__fact dd { margin: 0; }
  .hero__fact-link {
    text-decoration: none;
    font-size: var(--step-0);
    background-image: linear-gradient(var(--rule), var(--rule));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 100% 1px;
    transition: background-size 300ms var(--ease), color 300ms var(--ease);
    padding-bottom: 2px;
  }
  .hero__fact-link:hover { color: var(--teal); background-image: linear-gradient(var(--teal), var(--teal)); }
  .hero__fact-link--phone { font-family: var(--font-display); font-size: var(--step-2); letter-spacing: -0.01em; }

  /* --- Stage: layered depth --------------------------------------------- */
  .hero__stage {
    perspective: 1400px;
    perspective-origin: 60% 40%;
  }
  .hero__deck {
    position: relative;
    transform-style: preserve-3d;
    transform: rotateX(var(--rx, 0deg)) rotateY(var(--ry, 0deg));
    transition: transform 900ms var(--ease);
    will-change: transform;
  }
  .hero__stage[data-active='true'] .hero__deck { transition: transform 220ms ease-out; }

  .hero__wash {
    display: none;
    position: absolute;
    inset: -9% -12% -14% -8%;
    border-radius: 50% 46% 48% 52% / 44% 50% 50% 56%;
    background: radial-gradient(58% 58% at 42% 34%, rgba(66, 106, 116, 0.2) 0%, rgba(66, 106, 116, 0) 72%);
    transform: translateZ(-70px) scale(1.06);
  }
  .hero__frame {
    display: none;
    position: absolute;
    inset: 7% 12% 9% -7%;
    border: 1px solid var(--rule);
    transform: translateZ(-34px);
  }
  .hero__photo {
    position: relative;
    max-width: min(100%, 26rem);
    margin-inline: auto;
    transform: translateZ(0px);
    box-shadow:
      0 1px 1px rgba(29, 40, 45, 0.04),
      0 18px 40px -22px rgba(29, 40, 45, 0.34);
  }
  .hero__chip {
    position: absolute;
    left: max(0.75rem, calc(50% - 13rem - 0.75rem));
    bottom: 1.5rem;
    margin: 0;
    display: grid;
    gap: 0.15rem;
    padding: 0.7rem 1.05rem;
    background: var(--paper);
    border: 1px solid var(--rule);
    transform: translateZ(52px);
    box-shadow: 0 14px 30px -20px rgba(29, 40, 45, 0.4);
  }
  .hero__chip-label {
    font-size: 0.625rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .hero__chip-value { font-size: 0.875rem; font-weight: 500; letter-spacing: -0.005em; }

  /* --- Motion control ---------------------------------------------------- */
  .motion {
    position: absolute;
    right: clamp(1.25rem, 3vw, 3.5rem);
    bottom: 1.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.45rem 0.85rem;
    background: color-mix(in srgb, var(--warm-white) 82%, transparent);
    border: 1px solid var(--rule);
    border-radius: 999px;
    font-size: 0.75rem;
    color: var(--muted);
    cursor: pointer;
    transition: color 240ms var(--ease), border-color 240ms var(--ease);
  }
  .motion:hover { color: var(--fg); border-color: var(--fg); }
  .motion__dot { width: 5px; height: 5px; border-radius: 50%; background: var(--teal); }
  .motion[data-paused='true'] .motion__dot { background: var(--ink-55); }

  /* --- Layout ------------------------------------------------------------ */
  @media (min-width: 60rem) {
    .hero__inner {
      grid-template-columns: minmax(0, 1.16fr) minmax(0, 0.84fr);
      column-gap: clamp(2rem, 0.5rem + 4vw, 4.5rem);
      align-items: start;
    }
    .hero__text { grid-column: 1; grid-row: 1; }
    .hero__facts {
      grid-column: 1;
      grid-row: 2;
      grid-template-columns: 1fr 1fr;
      gap: var(--sp-4);
      align-self: end;
    }
    .hero__stage { grid-column: 2; grid-row: 1 / span 2; padding-inline: 1rem 0; align-self: center; }
    .hero__wash, .hero__frame { display: block; }
    .hero__photo { margin-inline: 0 0; margin-left: auto; }
    .hero__chip { left: max(-0.75rem, calc(100% - 26rem - 0.75rem)); }
  }

  /* Depth is decoration. Without motion the composition stays exactly as it is. */
  @media (prefers-reduced-motion: reduce) {
    .hero__deck { transform: none !important; }
  }
</style>

<script>
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)');
  const stage = document.querySelector<HTMLElement>('[data-stage]');
  const deck = stage?.querySelector<HTMLElement>('.hero__deck');
  const toggle = document.querySelector<HTMLButtonElement>('[data-motion-toggle]');
  const toggleLabel = toggle?.querySelector('[data-motion-label]');

  const STORAGE_KEY = 'marijan:motion-paused';
  const readPaused = () => {
    try { return localStorage.getItem(STORAGE_KEY) === '1'; } catch { return false; }
  };
  const writePaused = (v: boolean) => {
    try { localStorage.setItem(STORAGE_KEY, v ? '1' : '0'); } catch { /* private mode */ }
  };

  if (stage && deck && toggle) {
    let paused = readPaused();
    let frame = 0;
    let enabled = false;

    const rest = () => {
      deck.style.setProperty('--rx', '0deg');
      deck.style.setProperty('--ry', '0deg');
      stage.dataset.active = 'false';
    };

    const onMove = (e: PointerEvent) => {
      if (frame) return;
      frame = requestAnimationFrame(() => {
        frame = 0;
        const box = stage.getBoundingClientRect();
        const x = (e.clientX - box.left) / box.width - 0.5;
        const y = (e.clientY - box.top) / box.height - 0.5;
        // Deliberately small: depth should be felt, not watched.
        deck.style.setProperty('--ry', `${(x * 5).toFixed(2)}deg`);
        deck.style.setProperty('--rx', `${(-y * 3.4).toFixed(2)}deg`);
        stage.dataset.active = 'true';
      });
    };
    const onLeave = () => { cancelAnimationFrame(frame); frame = 0; rest(); };

    const setEnabled = (on: boolean) => {
      if (on === enabled) return;
      enabled = on;
      if (on) {
        stage.addEventListener('pointermove', onMove);
        stage.addEventListener('pointerleave', onLeave);
      } else {
        stage.removeEventListener('pointermove', onMove);
        stage.removeEventListener('pointerleave', onLeave);
        onLeave();
      }
    };

    const sync = () => {
      const available = fine.matches && !reduced.matches;
      toggle.hidden = !available;
      if (!available) { setEnabled(false); return; }
      toggle.dataset.paused = String(paused);
      toggle.setAttribute('aria-pressed', String(paused));
      if (toggleLabel) toggleLabel.textContent = paused ? 'Bewegung aktivieren' : 'Bewegung pausieren';
      setEnabled(!paused);
    };

    toggle.addEventListener('click', () => { paused = !paused; writePaused(paused); sync(); });
    reduced.addEventListener('change', sync);
    fine.addEventListener('change', sync);

    // Nothing renders continuously, but an offscreen hero should not even listen.
    if ('IntersectionObserver' in window) {
      new IntersectionObserver((entries) => {
        const visible = entries[0]?.isIntersecting ?? true;
        if (!visible) setEnabled(false);
        else sync();
      }, { threshold: 0 }).observe(stage);
    }
    document.addEventListener('visibilitychange', () => {
      if (document.hidden) setEnabled(false); else sync();
    });

    sync();
  }
</script>
