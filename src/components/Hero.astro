---
import { PRACTICE } from '../data/practice';
import Figure from './Figure.astro';
---
<section class="hero" aria-labelledby="hero-title">
  <div class="hero__glow" aria-hidden="true"></div>

  <!-- The portrait is anchored into the stage: it bleeds off the right and
       bottom edges and its inner edge dissolves into the ink. -->
  <div class="hero__portrait">
    <Figure slot="portrait" ratio={[4, 5]} position="58% 18%" priority
            sizes="(max-width: 60rem) 100vw, 46vw" />
  </div>

  <div class="shell hero__inner">
    <p class="eyebrow hero__eyebrow">Dr. Hrvoje Marijan · Zahnarzt in München</p>

    <h1 id="hero-title" class="hero__title">
      <span class="hero__line1">Zahnmedizin.</span>
      <span class="hero__line2">Von Mensch<br class="hero__brk" /> zu Mensch.</span>
    </h1>

    <p class="hero__lede">
      Ob Kontrolle, Zahnreinigung oder Fragen zu Zahnersatz: Vereinbaren Sie Ihren
      Termin in der Kapuzinerstraße 11.
    </p>

    <div class="btn-row hero__actions">
      <a class="btn btn--light" href={PRACTICE.phoneHref}>
        <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
          <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round"/>
        </svg>
        <span>Termin telefonisch vereinbaren</span>
      </a>
      <a class="link hero__second" href="/praxis/">
        Praxis kennenlernen
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
        </svg>
      </a>
    </div>

    <p class="hero__utility">
      <span>{PRACTICE.street} · {PRACTICE.city}</span>
      <span class="hero__sep" aria-hidden="true"></span>
      <a href={PRACTICE.phoneHref}>{PRACTICE.phoneDisplay}</a>
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    background: var(--ink);
    color: var(--paper);
    padding-block: clamp(2.25rem, 1.4rem + 3.2vw, 4.5rem) clamp(2.5rem, 1.6rem + 3.4vw, 4rem);
  }

  .hero__glow {
    position: absolute;
    inset: -20% -10% auto -30%;
    height: 120%;
    background: radial-gradient(46% 52% at 26% 34%, rgba(186, 99, 71, 0.16) 0%, rgba(186, 99, 71, 0) 68%),
                radial-gradient(58% 60% at 78% 18%, rgba(220, 231, 237, 0.14) 0%, rgba(220, 231, 237, 0) 70%);
    z-index: -2;
    pointer-events: none;
  }

  .hero__inner { position: relative; z-index: 1; }
  .hero__eyebrow { color: #9fb4c3; margin-bottom: var(--sp-4); }

  .hero__title { margin: 0 0 var(--sp-4); }
  .hero__line1 { display: block; }
  /* Line two steps in and drops, so the type reads as a composition, not a block. */
  .hero__line2 { display: block; color: #cfe0ea; }
  .hero__brk { display: none; }

  .hero__lede {
    font-size: var(--fs-lede);
    line-height: 1.5;
    color: #b6c8d5;
    max-width: 27rem;
    margin-bottom: var(--sp-4);
  }
  .hero__actions { gap: var(--sp-3); margin-bottom: var(--sp-5); }
  .hero__second { color: var(--paper); border-bottom-color: var(--accent-lift); }
  .hero__second:hover { color: var(--accent-lift); }

  .hero__utility {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.65rem 0.9rem;
    margin: 0;
    padding-top: var(--sp-3);
    border-top: 1px solid #2c485d;
    max-width: none;
    font-size: var(--fs-sm);
    color: #9fb4c3;
  }
  .hero__sep { width: 4px; height: 4px; border-radius: 50%; background: var(--accent-lift); }
  .hero__utility a {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    color: var(--paper);
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .hero__utility a:hover { color: var(--accent-lift); }

  /* --- Portrait ---------------------------------------------------------- */
  .hero__portrait { position: relative; margin-top: var(--sp-5); }
  .hero__portrait :global(.figure) { background: transparent; }

  /* ----------------------------------------------------------------- mobile */
  @media (max-width: 59.9375rem) {
    .hero__portrait {
      margin-inline: calc(-1 * var(--gutter));
      -webkit-mask-image: linear-gradient(to bottom, #000 76%, transparent 100%);
      mask-image: linear-gradient(to bottom, #000 76%, transparent 100%);
    }
    /* On a phone the utility line follows the photograph. */
    .hero__inner { display: contents; }
    .hero {
      display: grid;
      grid-template-columns: 1fr;
      padding-inline: var(--gutter);
    }
    .hero > .shell { padding-inline: 0; }
    .hero__eyebrow, .hero__title, .hero__lede, .hero__actions, .hero__utility {
      max-width: var(--shell);
      margin-inline: auto;
      width: 100%;
    }
    .hero__utility { order: 3; margin-top: var(--sp-4); }
    .hero__portrait { order: 2; }
  }

  /* ---------------------------------------------------------------- desktop */
  @media (min-width: 60rem) {
    .hero { min-height: min(86svh, 820px); display: flex; align-items: center; }
    .hero__brk { display: inline; }
    .hero__inner { width: 100%; }

    .hero__eyebrow, .hero__title, .hero__lede, .hero__actions { max-width: 40rem; }
    .hero__line2 { padding-left: clamp(1.5rem, 5vw, 5.5rem); }

    .hero__portrait {
      position: absolute;
      right: 0;
      bottom: 0;
      top: 0;
      width: clamp(30rem, 46vw, 46rem);
      margin: 0;
      z-index: -1;
      /* Dissolve the inner and lower edges so the photograph sits in the scene
         rather than on top of it as a card. */
      -webkit-mask-image:
        linear-gradient(to right, transparent 0%, rgba(0,0,0,0.55) 14%, #000 34%),
        linear-gradient(to bottom, #000 72%, transparent 99%);
      mask-image:
        linear-gradient(to right, transparent 0%, rgba(0,0,0,0.55) 14%, #000 34%),
        linear-gradient(to bottom, #000 72%, transparent 99%);
      -webkit-mask-composite: source-in;
      mask-composite: intersect;
    }
    .hero__portrait :global(.figure) { height: 100%; aspect-ratio: auto; }
    .hero__portrait :global(.figure__img) { height: 100%; }

    .hero__utility { max-width: 34rem; }
  }

  @media (min-width: 78rem) {
    .hero__eyebrow, .hero__title, .hero__lede, .hero__actions { max-width: 46rem; }
  }
</style>
