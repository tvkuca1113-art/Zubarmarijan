---
import { PRACTICE, PUBLIC_LAUNCH, SITE_ORIGIN } from '../data/practice';

interface Props {
  title: string;
  description: string;
  lang?: string;
}
const { title, description } = Astro.props;

/**
 * The project is a private design proposal. Until the practice authorises a
 * launch, every page is noindex/nofollow, no canonical is emitted for a domain
 * that has not been approved, and no structured data is published.
 */
const indexable = PUBLIC_LAUNCH && SITE_ORIGIN !== null;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{title}</title>
<meta name="description" content={description} />

{indexable ? (
  <link rel="canonical" href={new URL(Astro.url.pathname, SITE_ORIGIN!).href} />
) : (
  <meta name="robots" content="noindex, nofollow" />
)}

<meta name="theme-color" content="#f5f4f0" />
<meta name="format-detection" content="telephone=yes" />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:locale" content="de_DE" />
<meta property="og:site_name" content={PRACTICE.practiceName} />

<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="preload" href="/fonts/newsreader-latin.woff2" as="font" type="font/woff2" crossorigin />
<link rel="preload" href="/fonts/inter-latin.woff2" as="font" type="font/woff2" crossorigin />
