---
/**
 * "Ein Zahn. Drei Perspektiven."
 *
 * An educational illustration, not a scan of a patient and not this practice's
 * equipment. The model is original work generated by scripts/build-tooth-model.mjs.
 *
 * Everything a visitor needs is plain HTML: the headings, the explanations, the
 * service links and the phone number all render and work with no JavaScript, no
 * WebGL and no model file. The canvas is an enhancement layered over a poster.
 */
import { PRACTICE } from '../data/practice';
import { TOOTH_STATES } from '../data/tooth-copy';
---
<section class="tooth band-ink" aria-labelledby="tooth-title">
  <div class="shell">
    <div class="tooth__head">
      <div>
        <span class="tick" aria-hidden="true"></span>
        <h2 id="tooth-title">Ein Zahn. Drei Perspektiven.</h2>
      </div>
      <p class="tooth__intro">
        Drei Situationen, die im Sprechzimmer immer wieder vorkommen. Wählen Sie eine aus.
      </p>
    </div>

    <div class="tooth__body">
      <!-- Stage ------------------------------------------------------------ -->
      <div class="stage" data-stage>
        <div class="stage__inner" data-inner>
        <picture class="stage__poster">
          <source type="image/avif" srcset="/images/derived/zahn-poster-640.avif 640w, /images/derived/zahn-poster-900.avif 900w, /images/derived/zahn-poster-1200.avif 1200w" sizes="(max-width: 60rem) 92vw, 44vw" />
          <source type="image/webp" srcset="/images/derived/zahn-poster-640.webp 640w, /images/derived/zahn-poster-900.webp 900w, /images/derived/zahn-poster-1200.webp 1200w" sizes="(max-width: 60rem) 92vw, 44vw" />
          <img
            src="/images/derived/zahn-poster-900.png"
            srcset="/images/derived/zahn-poster-640.png 640w, /images/derived/zahn-poster-900.png 900w, /images/derived/zahn-poster-1200.png 1200w"
            sizes="(max-width: 60rem) 92vw, 44vw"
            width="900" height="675"
            alt="Darstellung eines Backenzahns mit zwei Wurzeln und vier Höckern auf der Kaufläche."
            loading="lazy" decoding="async"
          />
        </picture>
        <canvas class="stage__canvas" data-canvas aria-hidden="true"></canvas>
        </div>

        <button class="stage__activate" type="button" data-activate hidden>
          <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
            <path d="M12 3 3.5 7.5v9L12 21l8.5-4.5v-9L12 3Z" stroke-linejoin="round"/><path d="M3.5 7.5 12 12l8.5-4.5M12 12v9"/>
          </svg>
          <span>3D ansehen</span>
        </button>

        <p class="stage__note">Vereinfachte Darstellung</p>
        <p class="stage__fallback" data-fallback hidden>
          Die 3D-Darstellung lässt sich hier nicht laden. Die Erklärungen daneben gelten unverändert.
        </p>
      </div>

      <!-- Controls and explanation ----------------------------------------- -->
      <div class="tooth__panelwrap">
        <div class="tooth__tabs" role="tablist" aria-label="Perspektive wählen">
          {TOOTH_STATES.map((s, i) => (
            <button
              class="tooth__tab" type="button" role="tab"
              id={`tt-${s.id}`} aria-controls={`tp-${s.id}`}
              aria-selected={i === 0 ? 'true' : 'false'}
              tabindex={i === 0 ? 0 : -1}
              data-state={s.id}
            >
              <span class="tooth__tab-num">{String(i + 1).padStart(2, '0')}</span>
              <span>{s.label}</span>
            </button>
          ))}
        </div>

        <!-- All three panels share one grid cell, so the height never jumps. -->
        <div class="tooth__panels">
          {TOOTH_STATES.map((s, i) => (
            <div
              class="tooth__panel" role="tabpanel"
              id={`tp-${s.id}`} aria-labelledby={`tt-${s.id}`}
              data-panel={s.id} data-active={i === 0 ? 'true' : 'false'} tabindex="0"
            >
              <h3 class="tooth__h3">{s.heading}</h3>
              <p class="tooth__text">{s.body}</p>
              <a class="link tooth__link" href={s.link.href}>
                {s.link.text}
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path d="M5 12h13M13 6l6 6-6 6" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
            </div>
          ))}
        </div>

        <p class="visually-hidden" role="status" aria-live="polite" data-announce></p>

        <div class="tooth__cta">
          <a class="btn btn--light" href={PRACTICE.phoneHref}>
            <svg class="btn__icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true">
              <path d="M6.5 3h3l1.5 4-2 1.5a12 12 0 0 0 6.5 6.5l1.5-2 4 1.5v3a2 2 0 0 1-2.2 2A17 17 0 0 1 4.5 5.2 2 2 0 0 1 6.5 3Z" stroke-linejoin="round"/>
            </svg>
            <span>Termin: {PRACTICE.phoneDisplay}</span>
          </a>
          <p class="tooth__disclaimer">
            Allgemeine Darstellung zur Erklärung. Sie ersetzt keine Untersuchung und
            keine Empfehlung für einen einzelnen Fall.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .tooth { position: relative; overflow: hidden; }

  .tooth__head { display: grid; gap: var(--sp-3); margin-bottom: var(--sp-6); }
  .tooth__intro { color: var(--muted-ink); max-width: 28rem; }
  @media (min-width: 60rem) {
    .tooth__head { grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); align-items: end; column-gap: var(--sp-6); }
    .tooth__intro { padding-bottom: 0.35rem; }
  }

  .tooth__body { display: grid; gap: var(--sp-5); }
  @media (min-width: 60rem) {
    .tooth__body {
      grid-template-columns: minmax(0, 1.06fr) minmax(0, 0.94fr);
      column-gap: clamp(2rem, 1rem + 3.4vw, 4rem);
      align-items: center;
    }
  }

  /* --- Stage -------------------------------------------------------------- */
  .stage {
    position: relative;
    aspect-ratio: 4 / 3;            /* reserved up front, so nothing shifts */
    border-radius: 10px;
    background:
      radial-gradient(62% 62% at 50% 42%, rgba(220, 231, 237, 0.10) 0%, rgba(220, 231, 237, 0) 72%),
      #142c3e;
    overflow: hidden;
  }
  .stage__inner {
    position: absolute;
    inset: 2.9rem 1rem 1rem;
  }
  @media (min-width: 60rem) { .stage__inner { inset: 3.2rem 1.5rem 1.5rem; } }
  .stage__poster,
  .stage__canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }
  .stage__poster { display: block; }
  .stage__poster img { width: 100%; height: 100%; object-fit: contain; }
  .stage__canvas { object-fit: contain; }
  /* Toggled by class rather than by an ancestor attribute selector: Astro's scoped
     styles rewrite the ancestor away, which silently broke the crossfade. */
  .stage__canvas { opacity: 0; transition: opacity 420ms var(--ease); }
  .stage__canvas.is-live { opacity: 1; }
  .stage__poster { transition: opacity 420ms var(--ease); }
  .stage__poster.is-hidden { opacity: 0; }

  .stage__activate {
    position: absolute;
    left: 50%;
    bottom: 1rem;
    transform: translateX(-50%);
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: var(--tap);
    padding: 0.6rem 1.15rem;
    background: rgba(246, 244, 239, 0.94);
    color: var(--ink);
    border: 0;
    border-radius: 999px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
  }

  .stage__note {
    position: absolute;
    left: 0.9rem;
    top: 0.9rem;
    margin: 0;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    background: rgba(18, 42, 60, 0.72);
    color: #b6c8d5;
    font-size: var(--fs-label);
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .stage__fallback {
    position: absolute;
    inset: auto 1rem 1rem;
    margin: 0;
    font-size: var(--fs-fine);
    color: #b6c8d5;
    background: rgba(18, 42, 60, 0.82);
    padding: 0.6rem 0.75rem;
    border-radius: 6px;
  }

  /* --- Controls ----------------------------------------------------------- */
  .tooth__tabs { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: var(--sp-4); }
  .tooth__tab {
    display: inline-flex;
    align-items: baseline;
    gap: 0.5rem;
    min-height: var(--tap);
    padding: 0.6rem 1.1rem;
    background: transparent;
    color: #c9d8e3;
    border: 1.5px solid #2c485d;
    border-radius: 6px;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    transition: background 240ms var(--ease), color 240ms var(--ease), border-color 240ms var(--ease);
  }
  .tooth__tab:hover { border-color: #52738c; color: var(--paper); }
  .tooth__tab[aria-selected='true'] {
    background: var(--paper);
    border-color: var(--paper);
    color: var(--ink);
  }
  .tooth__tab-num { font-size: var(--fs-label); color: var(--accent-lift); font-variant-numeric: tabular-nums; }
  .tooth__tab[aria-selected='true'] .tooth__tab-num { color: var(--accent-ink); }

  .tooth__panels { display: grid; }
  .tooth__panel {
    grid-area: 1 / 1;
    visibility: hidden;
    opacity: 0;
    transition: opacity 320ms var(--ease);
  }
  .tooth__panel[data-active='true'] { visibility: visible; opacity: 1; }
  .tooth__h3 { margin-bottom: var(--sp-2); max-width: 20ch; }
  .tooth__text { color: var(--muted-ink); margin-bottom: var(--sp-3); max-width: 32rem; }
  .tooth__link { color: var(--paper); border-bottom-color: var(--accent-lift); }
  .tooth__link:hover { color: var(--accent-lift); }

  .tooth__cta {
    margin-top: var(--sp-5);
    padding-top: var(--sp-4);
    border-top: 1px solid #2c485d;
    display: grid;
    gap: var(--sp-3);
    justify-items: start;
  }
  .tooth__disclaimer { font-size: var(--fs-fine); color: #8ea4b4; max-width: 30rem; }
</style>

<script>
  import { TOOTH_VIEWS, cameraPosition, SCENE_LIGHT } from '../data/tooth-views.js';
  import { TOOTH_STATES } from '../data/tooth-copy';

  const sectionEl = document.querySelector<HTMLElement>('.tooth');
  if (sectionEl) {
    const section = sectionEl;
    const stage = section.querySelector<HTMLElement>('[data-stage]')!;
    const canvas = section.querySelector<HTMLCanvasElement>('[data-canvas]')!;
    const activate = section.querySelector<HTMLButtonElement>('[data-activate]')!;
    const fallback = section.querySelector<HTMLElement>('[data-fallback]')!;
    const announce = section.querySelector<HTMLElement>('[data-announce]')!;
    const tabs = Array.from(section.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('[data-panel]'));

    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const finePointer = window.matchMedia('(hover: hover) and (pointer: fine)');
    const wideEnough = window.matchMedia('(min-width: 48rem)');

    let current = 'verstehen';
    let scene: any = null;      // filled in once three.js is loaded
    let loading = false;

    /* ---------------------------------------------------------- panel state */
    const select = (id: string, focusTab = false) => {
      current = id;
      tabs.forEach((tab) => {
        const on = tab.dataset.state === id;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focusTab) tab.focus();
      });
      panels.forEach((p) => p.setAttribute('data-active', String(p.dataset.panel === id)));
      const meta = TOOTH_STATES.find((s) => s.id === id);
      if (meta) announce.textContent = meta.announce;
      if (scene) scene.goTo(id);
    };

    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.state!, false));
      tab.addEventListener('keydown', (e) => {
        const last = tabs.length - 1;
        let next: number | null = null;
        if (e.key === 'ArrowRight' || e.key === 'ArrowDown') next = i === last ? 0 : i + 1;
        else if (e.key === 'ArrowLeft' || e.key === 'ArrowUp') next = i === 0 ? last : i - 1;
        else if (e.key === 'Home') next = 0;
        else if (e.key === 'End') next = last;
        if (next !== null) { e.preventDefault(); select(tabs[next].dataset.state!, true); }
      });
    });

    /* ------------------------------------------------------------ the scene */
    async function boot() {
      if (scene || loading) return;
      loading = true;
      try {
        // Named imports so the bundler keeps only the parts this scene uses.
        const {
          WebGLRenderer, Scene, PerspectiveCamera, DirectionalLight,
          PMREMGenerator, Vector3, ACESFilmicToneMapping,
        } = await import('three');
        const { GLTFLoader } = await import('three/examples/jsm/loaders/GLTFLoader.js');
        const { RoomEnvironment } = await import('three/examples/jsm/environments/RoomEnvironment.js');

        const renderer = new WebGLRenderer({ canvas, antialias: true, alpha: true, powerPreference: 'low-power' });
        renderer.setPixelRatio(Math.min(window.devicePixelRatio || 1, 2));
        renderer.toneMapping = ACESFilmicToneMapping;
        renderer.toneMappingExposure = SCENE_LIGHT.exposure;

        const three = new Scene();
        const pmrem = new PMREMGenerator(renderer);
        three.environment = pmrem.fromScene(new RoomEnvironment(), 0.04).texture;
        (three as any).environmentIntensity = SCENE_LIGHT.environmentIntensity;

        for (const name of ['key', 'rim', 'fill'] as const) {
          const cfg = (SCENE_LIGHT as any)[name];
          const light = new DirectionalLight(cfg.color, cfg.intensity);
          light.position.set(cfg.position[0], cfg.position[1], cfg.position[2]);
          three.add(light);
        }

        const camera = new PerspectiveCamera(30, 4 / 3, 0.1, 40);
        const target = new Vector3(0, 0, 0);

        const gltf: any = await new Promise((resolve, reject) => {
          new GLTFLoader().load('/models/zahn.glb', resolve, undefined, reject);
        });
        const root = gltf.scene;
        three.add(root);
        const parts: Record<string, any> = {};
        root.children.forEach((child: any) => { parts[child.name] = child; });
        const crown = parts['krone'];
        const crownBaseY = crown ? crown.position.y : 0;

        /* ---- animation state ------------------------------------------- */
        let from = { ...TOOTH_VIEWS.verstehen.camera };
        let to = { ...TOOTH_VIEWS.verstehen.camera };
        let t = 1;                 // 0..1 through the current camera move
        let dur = 650;
        let last = performance.now();
        let entrance = 0;          // 0..1 for the one-off settle-in
        let lift = 0;              // crown separation progress
        let liftDir = 0;
        let liftHold = 0;
        let tiltX = 0, tiltY = 0, aimX = 0, aimY = 0;
        let running = false;
        let visible = true;
        let frame = 0;

        const MAX_TILT = 6 * (Math.PI / 180);   // ±6 degrees, no more
        const lerp = (a: number, b: number, k: number) => a + (b - a) * k;
        const easeInOut = (k: number) => (k < 0.5 ? 4 * k * k * k : 1 - Math.pow(-2 * k + 2, 3) / 2);

        type ViewId = keyof typeof TOOTH_VIEWS;
        const viewFor = (id: string) => TOOTH_VIEWS[id as ViewId];

        function applyVisibility(id: string) {
          const show = viewFor(id).show;
          for (const [name, obj] of Object.entries(parts)) obj.visible = show.includes(name);
        }

        const inner = section.querySelector<HTMLElement>('[data-inner]')!;
        function resize() {
          const rect = inner.getBoundingClientRect();
          const w = Math.max(1, Math.round(rect.width));
          const h = Math.max(1, Math.round(rect.height));
          renderer.setSize(w, h, false);
          camera.aspect = w / h;
          camera.updateProjectionMatrix();
        }

        function draw() {
          const cam = {
            azimuth: lerp(from.azimuth, to.azimuth, easeInOut(t)) + aimX,
            elevation: lerp(from.elevation, to.elevation, easeInOut(t)) + aimY,
            distance: lerp(from.distance, to.distance, easeInOut(t)) * (1 + (1 - entrance) * 0.16),
            targetY: lerp(from.targetY, to.targetY, easeInOut(t)),
          };
          const [x, y, z] = cameraPosition(cam);
          camera.position.set(x, y, z);
          target.set(0, cam.targetY, 0);
          camera.lookAt(target);
          if (crown) crown.position.y = crownBaseY + lift * (TOOTH_VIEWS.erhalten.crownLift ?? 0);
          root.rotation.y = (1 - entrance) * -0.22;
          renderer.render(three, camera);
        }

        function tick(now: number) {
          frame = 0;
          const dt = Math.min(64, now - last);
          last = now;
          let busy = false;

          if (t < 1) { t = Math.min(1, t + dt / dur); busy = true; }
          if (entrance < 1) { entrance = Math.min(1, entrance + dt / 1200); busy = true; }

          if (liftDir !== 0) {
            if (liftDir > 0) {
              lift = Math.min(1, lift + dt / 700);
              if (lift >= 1) { liftDir = 0; liftHold = 620; }
            } else {
              lift = Math.max(0, lift - dt / 700);
              if (lift <= 0) liftDir = 0;
            }
            busy = true;
          } else if (liftHold > 0) {
            liftHold -= dt;
            if (liftHold <= 0) liftDir = -1;
            busy = true;
          }

          const ease = 1 - Math.pow(0.0016, dt / 1000);
          if (Math.abs(aimX - tiltX) > 1e-4 || Math.abs(aimY - tiltY) > 1e-4) {
            aimX = lerp(aimX, tiltX, ease);
            aimY = lerp(aimY, tiltY, ease);
            busy = true;
          }

          draw();
          running = busy && visible;
          if (running) frame = requestAnimationFrame(tick);
        }

        function kick() {
          if (!visible) return;
          last = performance.now();
          if (!frame) { running = true; frame = requestAnimationFrame(tick); }
        }

        function goTo(id: string) {
          const view = viewFor(id);
          if (!view) return;
          const eased = easeInOut(t);
          from = {
            azimuth: lerp(from.azimuth, to.azimuth, eased),
            elevation: lerp(from.elevation, to.elevation, eased),
            distance: lerp(from.distance, to.distance, eased),
            targetY: lerp(from.targetY, to.targetY, eased),
          };
          to = { ...view.camera };
          t = reduced.matches ? 1 : 0;
          dur = 680;
          applyVisibility(id);
          if ((view as any).crownLift && !reduced.matches) { lift = 0; liftDir = 1; liftHold = 0; }
          else { lift = 0; liftDir = 0; liftHold = 0; }
          if (reduced.matches) { entrance = 1; draw(); }
          else kick();
        }

        /* ---- pointer: a small orientation nudge, never a spin ------------ */
        if (finePointer.matches && !reduced.matches) {
          stage.addEventListener('pointermove', (e) => {
            const r = stage.getBoundingClientRect();
            tiltX = ((e.clientX - r.left) / r.width - 0.5) * 2 * MAX_TILT;
            tiltY = -((e.clientY - r.top) / r.height - 0.5) * 2 * MAX_TILT * 0.6;
            kick();
          });
          stage.addEventListener('pointerleave', () => { tiltX = 0; tiltY = 0; kick(); });
        }

        /* ---- lifecycle --------------------------------------------------- */
        const io = new IntersectionObserver((entries) => {
          visible = entries[0]?.isIntersecting ?? true;
          if (visible) kick();
          else if (frame) { cancelAnimationFrame(frame); frame = 0; running = false; }
        }, { threshold: 0 });
        io.observe(stage);

        document.addEventListener('visibilitychange', () => {
          if (document.hidden) { if (frame) { cancelAnimationFrame(frame); frame = 0; running = false; } }
          else kick();
        });

        let resizeFrame = 0;
        window.addEventListener('resize', () => {
          if (resizeFrame) return;
          resizeFrame = requestAnimationFrame(() => { resizeFrame = 0; resize(); kick(); });
        });

        canvas.addEventListener('webglcontextlost', (e) => {
          e.preventDefault();
          if (frame) { cancelAnimationFrame(frame); frame = 0; }
          stage.dataset.live = 'false';
          canvas.classList.remove('is-live');
          poster?.classList.remove('is-hidden');
          fallback.hidden = false;
        });
        canvas.addEventListener('webglcontextrestored', () => {
          fallback.hidden = true;
          stage.dataset.live = 'true';
          canvas.classList.add('is-live');
          poster?.classList.add('is-hidden');
          resize(); kick();
        });

        const poster = section.querySelector<HTMLElement>('.stage__poster');
        scene = { goTo };
        resize();
        applyVisibility(current);
        if (reduced.matches) { entrance = 1; t = 1; draw(); }
        else { entrance = 0; t = 1; kick(); }
        stage.dataset.live = 'true';
        canvas.classList.add('is-live');
        poster?.classList.add('is-hidden');
        activate.hidden = true;
        if (current !== 'verstehen') goTo(current);
      } catch (err) {
        fallback.hidden = false;
        activate.hidden = true;
        stage.dataset.live = 'false';
      } finally {
        loading = false;
      }
    }

    /* ---- when to load ------------------------------------------------------
       Nothing here competes with the first view. The scene is only fetched after
       the page has finished loading, and only once the section is genuinely
       close. Narrow screens, coarse pointers, data saving and slow connections
       keep the poster until someone asks for 3D. */
    const conn = (navigator as any).connection;
    const thrifty = !!conn && (conn.saveData === true || /(^|-)2g$/.test(conn.effectiveType ?? ''));
    const wantsAuto = () => wideEnough.matches && finePointer.matches && !thrifty;

    const offerButton = () => {
      activate.hidden = false;
      activate.addEventListener('click', () => { activate.hidden = true; boot(); }, { once: true });
    };

    if (wantsAuto()) {
      const arm = () => {
        const io = new IntersectionObserver((entries) => {
          if (entries.some((e) => e.isIntersecting)) { io.disconnect(); boot(); }
        }, { rootMargin: '150px' });
        io.observe(stage);
      };
      const whenIdle = () => ('requestIdleCallback' in window
        ? (window as any).requestIdleCallback(arm, { timeout: 2000 })
        : setTimeout(arm, 400));
      if (document.readyState === 'complete') whenIdle();
      else window.addEventListener('load', whenIdle, { once: true });
    } else {
      offerButton();
    }
  }
</script>
